<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="SlaRealtimeGrid" constructor="SlaGridControl" version="1.0.0" display-name-key="SLA Real-Time Grid" description-key="Displays Case SLA countdowns and statuses in real time." control-type="virtual" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <property
  name="EnableNegativeTimer"
  display-name-key="EnableNegativeTimer_DisplayName"
  description-key="EnableNegativeTimer_Description"
  of-type="TwoOptions"
  usage="input"
  required="false" />
  <property
  name="FirstStageSlaItemName"
  display-name-key="FirstStageSlaItemName_DisplayName"
  description-key="Exact Dataverse SLA Item name for the first stage. Defaults to First Response."
  of-type="SingleLine.Text"
  usage="input"
  required="false" />
  <property
  name="ResolutionSlaItemName"
  display-name-key="ResolutionSlaItemName_DisplayName"
  description-key="Exact Dataverse SLA Item name for resolution. Defaults to Resolution."
  of-type="SingleLine.Text"
  usage="input"
  required="false" />
  <property
  name="FirstStageLabel"
  display-name-key="FirstStageLabel_DisplayName"
  description-key="Column label for the first SLA stage. Defaults to First Response."
  of-type="SingleLine.Text"
  usage="input"
  required="false" />
  <property
  name="GridTitle"
  display-name-key="GridTitle_DisplayName"
  description-key="Optional title displayed above the grid."
  of-type="SingleLine.Text"
  usage="input"
  required="false" />
  <property
  name="GridSubtitle"
  display-name-key="GridSubtitle_DisplayName"
  description-key="Optional subtitle displayed above the grid."
  of-type="SingleLine.Text"
  usage="input"
  required="false" />
  <property
  name="LayoutMode"
  display-name-key="LayoutMode_DisplayName"
  description-key="LayoutMode_Description"
  of-type="SingleLine.Text"
  usage="input"
  required="false" />
    <!-- dataset node represents a set of entity records on CDS; allow more than one datasets -->
    <data-set name="Cases" display-name-key="Cases_Dataset_DisplayName">
      <!-- 'property-set' node represents a unique, configurable property that each record in the dataset must provide. -->
      <!-- UNCOMMENT TO ADD PROPERTY-SET NODE
      <property-set name="samplePropertySet" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type="SingleLine.Text" usage="bound" required="true" />
      -->
    </data-set>
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      
      <css
  path="SlaGridControl.css"
  order="1" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="SlaGridControl.css" order="1" />
      <resx path="strings/SlaGridControl.1033.resx" version="1.0.0" />
      -->
    </resources>
     <!--UNCOMMENT TO ENABLE THE SPECIFIED API -->
    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    
  </control>
</manifest>

